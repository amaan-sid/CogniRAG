# Google Gemini API Configuration (Steps 3, 5, 7)
GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Vector DB Configuration - MongoDB Vector Search (Steps 4, 6)
MONGODB_VECTOR_COLLECTION=vectors
MONGODB_VECTOR_INDEX=vector_index

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/rag_db

# AWS S3 PDF Storage Configuration (Step 9 / Storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET_NAME=your_pdf_bucket

# NextAuth / JWT Authentication (Step 10 / Auth)
NEXTAUTH_SECRET=super_secret_jwt_key_change_me
NEXTAUTH_URL=http://localhost:3000
